{
  "schemaVersion": "1.0",
  "id": "quotation-builder",
  "displayName": "报价方案生成",
  "version": "1.0.0",
  "description": "依据已确认 Brief、项目主档和报价模板生成单条、拆项、月度、年框或框架服务报价草案。用于首次报价、方案调整、价格解释和版本对比。",
  "entry": "SKILL.md",
  "enabledByDefault": true,
  "triggers": [
    "需要新建报价",
    "客户要求拆项或多方案报价",
    "报价范围、数量或税率变更",
    "需要解释报价构成"
  ],
  "requiredTools": [
    "business.project.read",
    "business.template.read",
    "business.calculation",
    "business.artifact.create",
    "business.approval.request"
  ],
  "permissions": [
    "project.read",
    "template.read:quotation",
    "artifact.write:draft",
    "pricing.read"
  ],
  "outputArtifacts": [
    {
      "type": "business.quotation.draft",
      "mode": "draft-or-reviewed"
    },
    {
      "type": "business.quotation.explanation",
      "mode": "draft-or-reviewed"
    },
    {
      "type": "business.quotation.diff",
      "mode": "draft-or-reviewed"
    }
  ],
  "humanApprovalRequired": true,
  "source": "bsaigc-business"
}
