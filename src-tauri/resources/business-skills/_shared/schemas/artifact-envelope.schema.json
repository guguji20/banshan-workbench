{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bsaigc://business/artifact-envelope.schema.json",
  "title": "Business Artifact Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "artifactType",
    "projectId",
    "revision",
    "status",
    "createdAt",
    "sources",
    "data"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "artifactType": {
      "type": "string",
      "pattern": "^business\\."
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "pending-approval",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "revision"
        ],
        "properties": {
          "artifactId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "locator": {
            "type": "string"
          },
          "excerptHash": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision",
          "at"
        ],
        "properties": {
          "decision": {
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "by": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
