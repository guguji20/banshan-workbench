{
  "name": "bsaigc-desktop",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "check": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "skills:update": "node scripts/update-business-skills-bundle.mjs",
    "skills:validate": "node scripts/validate-business-skills.mjs",
    "test:watch": "vitest --configLoader runner",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "pnpm release:verify && tauri build --bundles nsis",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "codex:probe:test": "cargo test --manifest-path src-tauri/Cargo.toml official_app_server_handshake -- --ignored --nocapture",
    "codex:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-codex-protocol.ps1",
    "protocol:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-bsaigc-protocol.ps1",
    "verify": "pnpm skills:validate && pnpm protocol:generate && pnpm test && pnpm check && pnpm build && pnpm rust:fmt:check && pnpm rust:check && pnpm rust:clippy && pnpm rust:test",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "codex:sidecar:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-codex-sidecar.ps1",
    "codex:sidecar:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-codex-sidecar.ps1",
    "release:verify": "pnpm verify && pnpm codex:sidecar:verify && pnpm test:macos-release-evidence && pnpm test:formal-release-evidence && pnpm test:release-workflow-policy && pnpm test:r2-release-transaction && pnpm test:source-snapshot && pnpm test:windows-secondary-machine-acceptance && pnpm test:data-migration-rollback-acceptance && git diff --check",
    "verify:macos-release-evidence": "node scripts/verify-macos-release-evidence.mjs",
    "release:build": "pnpm desktop:build",
    "release:build:internal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-internal-preview.ps1",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "qa:fixtures": "python scripts/create-business-qa-fixtures.py && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-scanned-pdf-qa-fixture.ps1",
    "test:macos-release-evidence": "node --test scripts/verify-macos-release-evidence.test.mjs",
    "test:formal-release-evidence": "node --test scripts/verify-formal-release-evidence.test.mjs",
    "test:release-workflow-policy": "node --test scripts/verify-release-workflow-policy.test.mjs",
    "test:r2-release-transaction": "node --test scripts/verify-r2-release-transaction.test.mjs",
    "test:source-snapshot": "node --test scripts/create-source-snapshot.test.mjs",
    "test:windows-secondary-machine-acceptance": "node --test scripts/new-windows-secondary-machine-acceptance-bundle.test.mjs scripts/invoke-windows-secondary-machine-acceptance.test.mjs",
    "test:data-migration-rollback-acceptance": "node --test scripts/invoke-data-migration-rollback-acceptance.test.mjs",
    "verify:formal-release-evidence": "node scripts/verify-formal-release-evidence.mjs",
    "verify:release-workflow-policy": "node scripts/verify-release-workflow-policy.mjs",
    "verify:r2-release-transaction": "node scripts/verify-r2-release-transaction.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
